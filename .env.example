HTTP_PORT=8080
# Loopback by default (Caddy/host proxy in front). Temporary public access before HTTPS: HTTP_BIND=0.0.0.0
HTTP_BIND=127.0.0.1
# PLACEHOLDER ONLY: replace before starting Compose (openssl rand -hex 32).
# Compose rejects a missing/empty password; startup also rejects this placeholder.
DB_PASSWORD=CHANGE_ME_USE_A_RANDOM_PASSWORD
# Default without this variable: empty allowlist (no cross-origin browser access).
# Exact origins only, no trailing slash or wildcard. Replace the VPS placeholder.
CORS_ALLOWED_ORIGINS=https://ares-claudemaxxing.netlify.app,https://YOUR-VPS-DOMAIN
# Optional JSON argv array; leave empty for python3 -m scoring.cli.
SCORING_CMD=
